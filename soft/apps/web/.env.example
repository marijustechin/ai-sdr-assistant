# Web admin — server-side API connection.
#
# Copy to `.env.local` (git-ignored) inside apps/web before running the app:
#   cp .env.example .env.local
#
# These values are read only by Server Components and Server Actions. They are
# NEVER exposed to the browser: do not prefix them with NEXT_PUBLIC_.
# `INTERNAL_API_KEY` is the service-to-service secret required by every business
# endpoint (see apps/api/src/security/internal-api-key.guard.ts).

# Base URL of the NestJS API. Defaults to http://localhost:3003 when unset.
API_BASE_URL=http://localhost:3003

# Required for any product read/write. Generate a random value of at least 16
# characters and use the same value the API is started with.
INTERNAL_API_KEY=long_random_value_of_at_least_16_characters
