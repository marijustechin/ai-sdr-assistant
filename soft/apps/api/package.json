    "@nestjs/platform-fastify": "^11.0.1",
    "fastify": "^5.2.0",
    "imapflow": "^2.0.5",
    "nodemailer": "^10.0.10",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "eslint": "^9.18.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
