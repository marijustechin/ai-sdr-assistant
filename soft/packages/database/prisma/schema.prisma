// Prisma schema — single schema and migration chain.
//
// Owned by @ai-sdr/database (packages/database). No other package or module may
// define a schema or run migrations. Every model carries a `/// @owner <module>`
// tag so ownership is machine-readable (see docs/data-ownership.md §5).
//
// Prisma cannot express every constraint; CHECK constraints added in the
// initial migration SQL are documented in docs/data-model.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Canonical product identity (stored once, reusable across offers).
/// @owner products-and-offers
model Product {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String                 @db.VarChar(255)
  scientificName String?                @map("scientific_name") @db.VarChar(255)
  description    String?                @db.Text
  category       String?                @db.VarChar(120)
  lifecycleStatus ProductLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  /// Optional sender profile used for **buyer/sales outreach** only.
  outreachSenderProfileId String?              @map("outreach_sender_profile_id") @db.Uuid
  /// Optional sender profile used for **market-research price inquiries (RFQ)**
  /// only. Never falls back to the outreach sender.
  inquirySenderProfileId  String?              @map("inquiry_sender_profile_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  offers Offer[]
  facts  ProductFact[]
  priceInquiryDrafts PriceInquiryDraft[]
  outreachSenderProfile SenderProfile? @relation("ProductOutreachSender", fields: [outreachSenderProfileId], references: [id], onDelete: SetNull)
  inquirySenderProfile  SenderProfile? @relation("ProductInquirySender", fields: [inquirySenderProfileId], references: [id], onDelete: SetNull)

  @@index([outreachSenderProfileId])
  @@index([inquirySenderProfileId])
  @@map("products")
}

/// A concrete sellable product form (variant) of exactly one Product.
/// Example: "Thermo Abachi STS 3D" is an Offer of "Abachi".
/// @owner products-and-offers
model Offer {
  id               String      @id @default(uuid()) @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  name             String      @db.VarChar(255)
  commercialStatus OfferStatus @default(DRAFT) @map("commercial_status")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  facts          ProductFact[]
  opportunities  Opportunity[]

  @@index([productId])
  @@map("offers")
}

/// One structured fact about exactly one Product or one Offer (never both,
/// never neither — enforced by a CHECK constraint in the migration).
/// @owner products-and-offers
model ProductFact {
  id           String         @id @default(uuid()) @db.Uuid
  productId    String?        @map("product_id") @db.Uuid
  offerId      String?        @map("offer_id") @db.Uuid
  key          String         @db.VarChar(255)
  valueText    String?        @map("value_text") @db.Text
  valueNumeric Decimal?       @map("value_numeric") @db.Decimal(18, 6)
  unit         String?        @db.VarChar(64)
  status       FactStatus     @default(PENDING)
  visibility   FactVisibility @default(OPERATIONAL)
  sourceLabel  String?        @map("source_label") @db.VarChar(255)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  offer   Offer?   @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([offerId])
  @@index([key])
  @@map("product_facts")
}

/// A country/region + market segment combination (duplicates prevented).
/// `country` holds a country OR region identifier (documented simplification).
/// @owner opportunities
model TargetMarket {
  id             String             @id @default(uuid()) @db.Uuid
  country        String             @db.VarChar(120)
  segment        String             @db.VarChar(255)
  lifecycleStatus TargetMarketStatus @default(ACTIVE) @map("lifecycle_status")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  opportunities    OpportunityTargetMarket[]
  researchRunScopes ResearchRunTargetMarket[]

  @@unique([country, segment])
  @@map("target_markets")
}

/// The commercial work unit; belongs to exactly one Offer.
/// @owner opportunities
model Opportunity {
  id             String             @id @default(uuid()) @db.Uuid
  offerId        String             @map("offer_id") @db.Uuid
  name           String             @db.VarChar(255)
  objective      String?            @db.Text
  lifecycleStatus OpportunityStatus @default(DRAFT) @map("lifecycle_status")
  contextVersion Int                @default(1) @map("context_version")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  offer         Offer                        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  targetMarkets OpportunityTargetMarket[]
  researchRuns  ResearchRun[]
  leads         OpportunityCompany[]
  outreachDrafts OutreachDraft[]
  priceInquiryDrafts PriceInquiryDraft[]

  @@index([offerId])
  @@map("opportunities")
}

/// Explicit join between an Opportunity and its TargetMarkets.
/// @owner opportunities
model OpportunityTargetMarket {
  id            String       @id @default(uuid()) @db.Uuid
  opportunityId String       @map("opportunity_id") @db.Uuid
  targetMarketId String      @map("target_market_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  opportunity  Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  targetMarket TargetMarket  @relation(fields: [targetMarketId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, targetMarketId])
  @@index([targetMarketId])
  @@map("opportunity_target_markets")
}

/// An auditable record that market research was requested/executed for one
/// Opportunity. Holds no LLM chain-of-thought, credentials, or scraped pages.
/// @owner market-researcher
model ResearchRun {
  id             String            @id @default(uuid()) @db.Uuid
  opportunityId  String            @map("opportunity_id") @db.Uuid
  status         ResearchRunStatus @default(QUEUED)
  contextVersion Int               @map("context_version")
  requestedAt    DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt      DateTime?         @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?         @map("finished_at") @db.Timestamptz(6)
  errorCode      String?           @map("error_code") @db.VarChar(120)
  errorNote      String?           @map("error_note") @db.Text
  pauseReason    ResearchRunPauseReason? @map("pause_reason")
  pauseNote      String?           @map("pause_note") @db.Text
  checkpoint     Json?             @map("checkpoint")
  checkpointAt   DateTime?         @map("checkpoint_at") @db.Timestamptz(6)
  /// Validated operator request parameters (goals, geography, segment policy,
  /// questions, constraints, execution limits). Null for runs not created from
  /// the product-independent request flow.
  requestParameters Json?         @map("request_parameters")
  /// Optional client idempotency key so a double-click/retry cannot create a
  /// duplicate research request.
  requestKey     String?           @unique @map("request_key") @db.VarChar(120)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  opportunity   Opportunity               @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  targetMarkets ResearchRunTargetMarket[]
  queries       ResearchQuery[]
  evidence      Evidence[]
  claims        Claim[]
  offerings     ResearchOffering[]

  @@index([opportunityId])
  @@map("research_runs")
}

/// Target-market scope of a ResearchRun (explicit join + compound uniqueness).
/// @owner market-researcher
model ResearchRunTargetMarket {
  id             String       @id @default(uuid()) @db.Uuid
  researchRunId  String       @map("research_run_id") @db.Uuid
  targetMarketId String       @map("target_market_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  researchRun  ResearchRun  @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  targetMarket TargetMarket @relation(fields: [targetMarketId], references: [id], onDelete: Restrict)

  @@unique([researchRunId, targetMarketId])
  @@index([targetMarketId])
  @@map("research_run_target_markets")
}

/// A single discovery/search query issued during a ResearchRun: what was asked,
/// with which tool/provider, when it ran, and its outcome. Operational
/// provenance only — never model reasoning or chain-of-thought.
/// @owner market-researcher
model ResearchQuery {
  id            String              @id @default(uuid()) @db.Uuid
  researchRunId String              @map("research_run_id") @db.Uuid
  queryText     String              @map("query_text") @db.Text
  provider      String?             @db.VarChar(120)
  status        ResearchQueryStatus @default(PENDING)
  executedAt    DateTime?           @map("executed_at") @db.Timestamptz(6)
  resultCount   Int?                @map("result_count")
  errorCode     String?             @map("error_code") @db.VarChar(120)
  errorNote     String?             @map("error_note") @db.Text
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  researchRun ResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade)

  @@index([researchRunId])
  @@map("research_queries")
}

/// A concrete discovered source (usually a fetched URL), deduplicated by URL so
/// the same source is not stored repeatedly. This is the raw reference; the
/// factual observation extracted from it lives in `evidence`.
/// @owner evidence
model SourceReference {
  id         String   @id @default(uuid()) @db.Uuid
  url        String   @db.VarChar(2048)
  title      String?  @db.VarChar(512)
  publisher  String?  @db.VarChar(255)
  sourceType String?  @map("source_type") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence Evidence[]
  offerings ResearchOffering[]
  opportunityLeads OpportunityCompany[]
  contactSources ContactSource[]
  outreachDrafts OutreachDraft[]

  @@unique([url])
  @@map("source_references")
}

/// A factual observation extracted from a source during a run — the raw
/// evidence. Deliberately separate from `claims` (the conclusions drawn from
/// it), so evidence and inference cannot be collapsed.
/// @owner evidence
model Evidence {
  id                 String                     @id @default(uuid()) @db.Uuid
  sourceReferenceId  String                     @map("source_reference_id") @db.Uuid
  researchRunId      String                     @map("research_run_id") @db.Uuid
  evidenceText       String                     @map("evidence_text") @db.Text
  verificationStatus EvidenceVerificationStatus @default(UNVERIFIED) @map("verification_status")
  retrievedAt        DateTime?                  @map("retrieved_at") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceReference SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  researchRun     ResearchRun     @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  claimLinks      ClaimEvidence[]
  offerings       ResearchOffering[]
  opportunityLeads OpportunityCompany[]
  outreachDrafts  OutreachDraft[]

  @@index([sourceReferenceId])
  @@index([researchRunId])
  @@map("evidence")
}

/// A research conclusion/assertion derived from evidence. One claim may be
/// supported, contradicted, or contextualised by many evidence records.
///
/// A claim also has a small **correction lifecycle** (`lifecycleStatus`) that is
/// deliberately separate from `type` (FACT/INFERENCE/UNKNOWN) and from evidence
/// verification: a claim may be `CURRENT`, `RETRACTED`, or `REPLACED`. Retracted/
/// replaced claims are preserved (never edited or deleted); the correction
/// records its reason and timestamp, and a replacement points at another claim.
/// @owner evidence
model Claim {
  id               String              @id @default(uuid()) @db.Uuid
  researchRunId    String              @map("research_run_id") @db.Uuid
  type             ClaimType
  statement        String              @db.Text
  confidence       ClaimConfidence     @default(LOW)
  lifecycleStatus  ClaimLifecycleStatus @default(CURRENT) @map("lifecycle_status")
  correctionReason String?             @map("correction_reason") @db.Text
  correctedAt      DateTime?           @map("corrected_at") @db.Timestamptz(6)
  replacedByClaimId String?            @map("replaced_by_claim_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  researchRun   ResearchRun     @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  evidenceLinks ClaimEvidence[]
  replacedBy    Claim?          @relation("ClaimReplacement", fields: [replacedByClaimId], references: [id], onDelete: SetNull)
  replaces      Claim[]         @relation("ClaimReplacement")
  offerings     ResearchOffering[]
  opportunityLeads OpportunityCompany[]
  outreachDrafts OutreachDraft[]

  @@index([researchRunId])
  @@index([lifecycleStatus])
  @@map("claims")
}

/// Claim↔evidence link. `stance` keeps conflicting evidence explicit instead of
/// silently averaging it into one conclusion.
/// @owner evidence
model ClaimEvidence {
  id         String              @id @default(uuid()) @db.Uuid
  claimId    String              @map("claim_id") @db.Uuid
  evidenceId String              @map("evidence_id") @db.Uuid
  stance     ClaimEvidenceStance @default(SUPPORTS)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  claim    Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([claimId, evidenceId])
  @@index([evidenceId])
  @@map("claim_evidence")
}

/// A structured, evidence-linked company offering observed during a run (e.g. a
/// supplier's thermo-Abachi cladding listing). Stores only values explicitly
/// recorded in the linked evidence/claim; an unrecorded field stays null and its
/// enum stays `UNKNOWN`. Populated through the API with mandatory provenance
/// (`sourceReferenceId` + `evidenceId`, optional `claimId`) and deduplicated by
/// a per-run `fingerprint`, so re-importing the same observation cannot create a
/// duplicate. Never authored from prose by the UI.
/// @owner evidence
model ResearchOffering {
  id                  String             @id @default(uuid()) @db.Uuid
  researchRunId       String             @map("research_run_id") @db.Uuid
  companyText         String?            @map("company_text") @db.VarChar(255)
  companyLocationText String?            @map("company_location_text") @db.VarChar(255)
  marketServedText    String?            @map("market_served_text") @db.VarChar(255)
  productText         String?            @map("product_text") @db.VarChar(512)
  applicationText     String?            @map("application_text") @db.VarChar(255)
  treatmentText       String?            @map("treatment_text") @db.VarChar(255)
  dimensionsText      String?            @map("dimensions_text") @db.VarChar(255)
  priceText           String?            @map("price_text") @db.Text
  /// Explicit numeric amount stated by the source, on the same basis as
  /// `priceText`; never parsed from prose. Null means not recorded numerically.
  priceAmountNumeric  Decimal?           @map("price_amount_numeric") @db.Decimal(18, 6)
  priceCurrency       String?            @map("price_currency") @db.VarChar(12)
  priceUnit           String?            @map("price_unit") @db.VarChar(64)
  vatStatus           OfferingVatStatus  @default(UNKNOWN) @map("vat_status")
  priceBasis          OfferingPriceBasis @default(UNKNOWN) @map("price_basis")
  sampleKind          OfferingSampleKind @default(UNKNOWN) @map("sample_kind")
  matchType           OfferingMatchType  @default(UNKNOWN) @map("match_type")
  sourceReferenceId   String             @map("source_reference_id") @db.Uuid
  evidenceId          String             @map("evidence_id") @db.Uuid
  claimId             String?            @map("claim_id") @db.Uuid
  fingerprint         String             @db.VarChar(64)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  researchRun     ResearchRun     @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  sourceReference SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  evidence        Evidence        @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  claim           Claim?          @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@unique([fingerprint])
  @@index([researchRunId])
  @@index([evidenceId])
  @@index([claimId])
  @@map("research_offerings")
}

/// A potential-buyer organisation. Canonical, minimal identity only — no
/// contacts, ownership, demand or scoring. Deduplicated by a deterministic
/// `identityKey` (normalized name + country) so repeated submissions reuse one
/// row. This is not a CRM record and not a commitment.
/// @owner lead-discoverer
model Company {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  normalizedName String   @map("normalized_name") @db.VarChar(255)
  website        String?  @db.VarChar(2048)
  country        String?  @db.VarChar(120)
  identityKey    String   @map("identity_key") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads OpportunityCompany[]
  contacts Contact[]
  outreachDrafts OutreachDraft[]
  priceInquiryDrafts PriceInquiryDraft[]

  @@unique([identityKey])
  @@index([normalizedName])
  @@map("companies")
}

/// An opportunity-scoped candidate buyer, linked to the research evidence that
/// supports its inclusion. Observed facts (`observedActivityText`,
/// `observedRoles`) are stored separately from the buyer-fit hypothesis
/// (`buyerFitHypothesisText`); unknowns and the next verification step are
/// explicit. The operator review state is a separate dimension (see
/// `LeadReviewStatus`). Provenance is mandatory: `sourceReferenceId` (derived
/// from the evidence), `evidenceId`, and an optional CURRENT `claimId`. A
/// deterministic per-opportunity `dedupKey` keeps resubmission idempotent.
/// @owner lead-discoverer
model OpportunityCompany {
  id                       String           @id @default(uuid()) @db.Uuid
  opportunityId            String           @map("opportunity_id") @db.Uuid
  companyId                String           @map("company_id") @db.Uuid
  observedActivityText     String           @map("observed_activity_text") @db.Text
  observedRoles            String[]         @map("observed_roles")
  buyerFitHypothesisText   String           @map("buyer_fit_hypothesis_text") @db.Text
  unknownsText             String?          @map("unknowns_text") @db.Text
  nextVerificationStepText String?          @map("next_verification_step_text") @db.Text
  reviewStatus             LeadReviewStatus @default(UNREVIEWED) @map("review_status")
  reviewReason             String?          @map("review_reason") @db.Text
  reviewedAt               DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  agentQualificationStatus AgentQualificationStatus @default(NOT_ASSESSED) @map("agent_qualification_status")
  agentQualificationReason String?          @map("agent_qualification_reason") @db.Text
  agentAssessedAt          DateTime?        @map("agent_assessed_at") @db.Timestamptz(6)
  /// Basis the agent qualification rested on; a material provenance change
  /// (different evidence/claim) makes the prior qualification stale.
  agentQualificationEvidenceId String?      @map("agent_qualification_evidence_id") @db.Uuid
  agentQualificationClaimId    String?      @map("agent_qualification_claim_id") @db.Uuid
  sourceReferenceId        String           @map("source_reference_id") @db.Uuid
  evidenceId               String           @map("evidence_id") @db.Uuid
  claimId                  String?          @map("claim_id") @db.Uuid
  dedupKey                 String           @map("dedup_key") @db.VarChar(512)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  opportunity     Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceReference SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  evidence        Evidence        @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  claim           Claim?          @relation(fields: [claimId], references: [id], onDelete: SetNull)
  outreachDrafts  OutreachDraft[]
  priceInquiryDrafts PriceInquiryDraft[]

  @@unique([dedupKey])
  @@unique([opportunityId, companyId])
  @@index([opportunityId])
  @@index([companyId])
  @@index([claimId])
  @@map("opportunity_companies")
}

/// Operator review state of a potential-buyer candidate. Deliberately separate
/// from provenance and from any future qualification result; a review reason is
/// operator-authored and never model reasoning.
enum LeadReviewStatus {
  UNREVIEWED
  SHORTLISTED
  REJECTED
}

/// Agent qualification of a candidate, kept separate from the operator review.
/// The agent assesses candidates against documented, evidence-backed criteria and
/// records why; a human may override through `reviewStatus`, and an explicit
/// operator `REJECTED` always wins. Setting this never writes the review fields.
enum AgentQualificationStatus {
  NOT_ASSESSED
  QUALIFIED
  NEEDS_MORE_EVIDENCE
  DISQUALIFIED
}

/// An initial outreach draft prepared for one eligible lead, or an explicit
/// blocked preparation outcome. Drafts are append-only/versioned: a re-run with
/// identical inputs is idempotent (unique `fingerprint`) and a material change
/// creates a new version rather than overwriting the previous draft. No sending
/// is represented here, and no send state exists.
/// @owner outreach-drafter
model OutreachDraft {
  id                 String                    @id @default(uuid()) @db.Uuid
  opportunityId      String                    @map("opportunity_id") @db.Uuid
  leadId             String                    @map("lead_id") @db.Uuid
  companyId          String                    @map("company_id") @db.Uuid
  contactId          String?                   @map("contact_id") @db.Uuid
  recipientEmail     String?                   @map("recipient_email") @db.VarChar(320)
  language           String                    @db.VarChar(35)
  preparationStatus  OutreachPreparationStatus @default(BLOCKED) @map("preparation_status")
  subject            String?                   @db.VarChar(512)
  body               String?                   @db.Text
  rationale          String                    @db.Text
  recipientRationale String                    @map("recipient_rationale") @db.Text
  missingFields      String[]                  @map("missing_fields")
  contextVersion     Int?                      @map("context_version")
  evidenceId         String?                   @map("evidence_id") @db.Uuid
  claimId            String?                   @map("claim_id") @db.Uuid
  sourceReferenceId  String?                   @map("source_reference_id") @db.Uuid
  /// Sender profile reference + non-secret identity snapshot actually used.
  senderProfileId    String?                   @map("sender_profile_id") @db.Uuid
  /// Mailbox connection resolved from the sender profile at preparation time.
  emailAccountId     String?                   @map("email_account_id") @db.Uuid
  senderSnapshot     Json?                     @map("sender_snapshot")
  version            Int                       @default(1)
  fingerprint        String                    @db.VarChar(64)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  opportunity     Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  lead            OpportunityCompany @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact         Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  evidence        Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  claim           Claim?             @relation(fields: [claimId], references: [id], onDelete: SetNull)
  sourceReference SourceReference?   @relation(fields: [sourceReferenceId], references: [id], onDelete: SetNull)
  senderProfile   SenderProfile?     @relation(fields: [senderProfileId], references: [id], onDelete: SetNull)
  emailAccount    EmailAccount?      @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)

  @@unique([fingerprint])
  @@index([opportunityId])
  @@index([leadId])
  @@index([companyId])
  @@index([contactId])
  @@index([senderProfileId])
  @@index([emailAccountId])
  @@map("outreach_drafts")
}

/// Whether an initial outreach draft was prepared or explicitly blocked on
/// missing essential information. Sending is never implied.
enum OutreachPreparationStatus {
  PREPARED
  BLOCKED
}

/// A persisted, reviewable **price inquiry / RFQ draft**. Generated from
/// persisted product/specification data and linked to the opportunity, lead,
/// company, product, recipient contact, and sender identity. It never sends:
/// every draft starts at `READY_FOR_HUMAN_REVIEW` and no transport is invoked.
/// Future price-intelligence records (outbound message metadata, supplier reply,
/// quotation/document evidence, normalized price/currency/unit/MOQ/Incoterm/
/// origin/lead-time/validity) will reference this draft.
/// @owner price-inquiry
model PriceInquiryDraft {
  id                   String   @id @default(uuid()) @db.Uuid
  opportunityId        String   @map("opportunity_id") @db.Uuid
  leadId               String   @map("lead_id") @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  /// Selected published recipient (never inferred); the exact email is copied.
  contactId            String?  @map("contact_id") @db.Uuid
  recipientEmail       String?  @map("recipient_email") @db.VarChar(320)
  recipientRationale   String   @map("recipient_rationale") @db.Text
  /// Sender identity snapshot (non-secret) used for this draft.
  senderProfileId      String?  @map("sender_profile_id") @db.Uuid
  emailAccountId       String?  @map("email_account_id") @db.Uuid
  senderSnapshot       Json?    @map("sender_snapshot")
  purpose              PriceInquiryPurpose @default(PRICE_INQUIRY)
  status               PriceInquiryStatus  @default(READY_FOR_HUMAN_REVIEW)
  language             String   @db.VarChar(35)
  /// Editable review fields.
  subject              String   @db.VarChar(512)
  body                 String   @db.Text
  /// Immutable original generation, preserved for auditability.
  generatedSubject     String   @map("generated_subject") @db.VarChar(512)
  generatedBody        String   @map("generated_body") @db.Text
  /// The exact persisted specification grounding used to generate the draft.
  specificationSummary String   @map("specification_summary") @db.Text
  rationale            String   @db.Text
  /// Provenance of the company/contact selection.
  sourceReferenceId    String?  @map("source_reference_id") @db.Uuid
  evidenceId           String?  @map("evidence_id") @db.Uuid
  claimId              String?  @map("claim_id") @db.Uuid
  version              Int      @default(1)
  fingerprint          String   @db.VarChar(64)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  opportunity     Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  lead            OpportunityCompany @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product         Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  contact         Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  senderProfile   SenderProfile?     @relation(fields: [senderProfileId], references: [id], onDelete: SetNull)
  emailAccount    EmailAccount?      @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)

  @@unique([fingerprint])
  @@index([opportunityId])
  @@index([leadId])
  @@index([companyId])
  @@index([productId])
  @@index([contactId])
  @@index([senderProfileId])
  @@map("price_inquiry_drafts")
}

/// Purpose of a persisted draft. Only `PRICE_INQUIRY` (RFQ) exists in this slice.
enum PriceInquiryPurpose {
  PRICE_INQUIRY
}

/// Review status of a price inquiry draft. It never sends, so no `SENT` state
/// exists; every draft starts `READY_FOR_HUMAN_REVIEW`.
enum PriceInquiryStatus {
  READY_FOR_HUMAN_REVIEW
}

/// A reusable, product-independent sender identity for outreach drafts. An
/// identity carries **no** transport configuration: it references an
/// `EmailAccount` (owned by `email-accounts`) for the mailbox connection used to
/// send on its behalf. Many identities may share one email account.
/// @owner sender-profiles
model SenderProfile {
  id             String              @id @default(uuid()) @db.Uuid
  label          String              @db.VarChar(255)
  senderName     String              @map("sender_name") @db.VarChar(255)
  /// Optional role/title (e.g. "Sourcing & Procurement"); used for the RFQ
  /// closing. A company/brand is never invented when absent.
  senderTitle    String?             @map("sender_title") @db.VarChar(255)
  /// Optional company/brand. A sender profile is fully usable without it.
  companyName    String?             @map("company_name") @db.VarChar(255)
  fromEmail      String              @map("from_email") @db.VarChar(320)
  replyToEmail   String?             @map("reply_to_email") @db.VarChar(320)
  signature      String?             @db.Text
  status         SenderProfileStatus @default(ACTIVE)
  /// Optional mailbox connection. Never holds credentials itself.
  emailAccountId String?             @map("email_account_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  emailAccount   EmailAccount?       @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  products       Product[]           @relation("ProductOutreachSender")
  productInquiries Product[]         @relation("ProductInquirySender")
  outreachDrafts OutreachDraft[]
  priceInquiryDrafts PriceInquiryDraft[]

  @@index([emailAccountId])
  @@map("sender_profiles")
}

/// Enabled/disabled state of a sender profile. Disabled profiles cannot be used
/// for drafting but are retained (no hard delete).
enum SenderProfileStatus {
  ACTIVE
  DISABLED
}

/// The technical mailbox connection used to send (SMTP) and, later, to monitor
/// replies (IMAP). It is the only place transport secrets live; passwords are
/// stored only as encrypted ciphertext (key in server configuration, never in the
/// database or Git) and are never returned to a reader. No transport is executed
/// by this model (no sending, no IMAP connection in this slice).
/// @owner email-accounts
model EmailAccount {
  id                   String             @id @default(uuid()) @db.Uuid
  label                String             @db.VarChar(255)
  accountEmail         String             @map("account_email") @db.VarChar(320)
  status               EmailAccountStatus @default(ACTIVE)
  /// Optional provider hint (e.g. GENERIC, SAPIENSMETRIC); free-form.
  provider             String?            @db.VarChar(64)
  smtpHost             String?            @map("smtp_host") @db.VarChar(255)
  smtpPort             Int?               @map("smtp_port")
  smtpTlsMode          EmailTlsMode?      @map("smtp_tls_mode")
  smtpUsername         String?            @map("smtp_username") @db.VarChar(255)
  smtpPasswordCiphertext String?          @map("smtp_password_ciphertext") @db.Text
  imapHost             String?            @map("imap_host") @db.VarChar(255)
  imapPort             Int?               @map("imap_port")
  imapTlsMode          EmailTlsMode?      @map("imap_tls_mode")
  imapUsername         String?            @map("imap_username") @db.VarChar(255)
  imapPasswordCiphertext String?          @map("imap_password_ciphertext") @db.Text
  /// When true, IMAP reuses the SMTP username/password; separate IMAP
  /// credentials are then not stored.
  credentialsShared    Boolean            @default(false) @map("credentials_shared")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  senderProfiles SenderProfile[]
  outreachDrafts OutreachDraft[]
  priceInquiryDrafts PriceInquiryDraft[]

  @@map("email_accounts")
}

/// Enabled/disabled state of an email account. Disabled accounts are retained
/// (no hard delete) but cannot be used for drafting/sending.
enum EmailAccountStatus {
  ACTIVE
  DISABLED
}

/// Explicit TLS mode for SMTP/IMAP. Recorded; only bounded password
/// verification acts on it (no automated sending or mailbox ingestion).
enum EmailTlsMode {
  NONE
  STARTTLS
  SSL_TLS
}

/// Public business contact information for a company, published on a source.
/// Values are stored exactly as published; the `normalized*` columns exist only
/// for comparison/deduplication. `deliverabilityStatus` distinguishes "found /
/// published on a source" (`NOT_VERIFIED`) from a separately established
/// deliverability result. No email pattern, name, title or phone country code is
/// ever inferred.
/// @owner contact-discovery
model Contact {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  contactType          ContactType           @map("contact_type")
  email                String?               @db.VarChar(320)
  phone                String?               @db.VarChar(64)
  contactPageUrl       String?               @map("contact_page_url") @db.VarChar(2048)
  personName           String?               @map("person_name") @db.VarChar(255)
  personJobTitle       String?               @map("person_job_title") @db.VarChar(255)
  usabilityStatus      ContactUsability      @default(USABLE) @map("usability_status")
  unusableReason       String?               @map("unusable_reason") @db.Text
  deliverabilityStatus ContactDeliverability @default(NOT_VERIFIED) @map("deliverability_status")
  unknownsText         String?               @map("unknowns_text") @db.Text
  normalizedEmail      String?               @map("normalized_email") @db.VarChar(320)
  normalizedPhone      String?               @map("normalized_phone") @db.VarChar(64)
  dedupKey             String                @map("dedup_key") @db.VarChar(768)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sources ContactSource[]
  outreachDrafts OutreachDraft[]
  priceInquiryDrafts PriceInquiryDraft[]

  @@unique([dedupKey])
  @@index([companyId])
  @@map("contacts")
}

/// Provenance of one contact: which discovered source (deduplicated by URL)
/// states it, when it was retrieved, and the supporting excerpt. One contact may
/// carry many sources, so contact discovery never overwrites earlier provenance.
/// @owner contact-discovery
model ContactSource {
  id                String   @id @default(uuid()) @db.Uuid
  contactId         String   @map("contact_id") @db.Uuid
  sourceReferenceId String   @map("source_reference_id") @db.Uuid
  retrievedAt       DateTime @map("retrieved_at") @db.Timestamptz(6)
  excerptText       String   @map("excerpt_text") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sourceReference SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)

  @@unique([contactId, sourceReferenceId])
  @@index([sourceReferenceId])
  @@map("contact_sources")
}

/// Whether a contact is a general company channel or a named person.
enum ContactType {
  GENERAL_COMPANY
  NAMED_PERSON
}

/// Operator/agent judgement of whether a contact is usable. `UNUSABLE` retains
/// the row and its provenance (with a reason) instead of deleting it.
enum ContactUsability {
  USABLE
  UNUSABLE
}

/// `NOT_VERIFIED` means the value was only found/published on a source; it does
/// not establish that it works or reaches purchasing. `VERIFIED` requires a
/// separate, recorded verification. `UNKNOWN` means not established.
enum ContactDeliverability {
  NOT_VERIFIED
  VERIFIED
  UNKNOWN
}

enum ProductLifecycleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OpportunityStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum TargetMarketStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FactStatus {
  PENDING
  CONFIRMED
  SUPERSEDED
}

enum FactVisibility {
  OPERATIONAL
  RESTRICTED
}

enum ResearchRunStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

/// Why a `PAUSED` run stopped. Kept separate from the lifecycle status and from
/// `error*` (which belong to `FAILED`).
enum ResearchRunPauseReason {
  BUDGET_EXHAUSTED
  ACCESS_BLOCKED
  CONTEXT_CHANGED
  DIMINISHING_RETURNS
  NEEDS_HUMAN
}

enum ResearchQueryStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Whether an evidence item rests on a fetched, retrievable source (`VERIFIED`)
/// or is still a lead (`UNVERIFIED`). `UNKNOWN` conclusions are claim types.
enum EvidenceVerificationStatus {
  VERIFIED
  UNVERIFIED
}

/// Canonical claim types: a `FACT` is stated by fetched evidence, an
/// `INFERENCE` is derived from evidence, an `UNKNOWN` is not established.
enum ClaimType {
  FACT
  INFERENCE
  UNKNOWN
}

enum ClaimConfidence {
  HIGH
  MEDIUM
  LOW
}

/// Correction lifecycle of a claim, kept separate from `ClaimType` and from
/// `EvidenceVerificationStatus`. `REPLACED` claims carry a `replacedByClaimId`;
/// `RETRACTED` claims do not.
enum ClaimLifecycleStatus {
  CURRENT
  RETRACTED
  REPLACED
}

/// Recorded VAT treatment of an offering price. `UNKNOWN` means not recorded.
enum OfferingVatStatus {
  INCLUDED
  EXCLUDED
  NOT_STATED
  UNKNOWN
}

/// Recorded commercial basis of an offering price. Never inferred.
enum OfferingPriceBasis {
  RETAIL_LIST
  TRADE_B2B
  UNKNOWN
}

/// Whether a recorded price is for a sample or a full product. Never inferred.
enum OfferingSampleKind {
  SAMPLE
  FULL_PRODUCT
  UNKNOWN
}

/// How an offering relates to the researched product. Never inferred from prose
/// alone; the researcher records the classification explicitly.
enum OfferingMatchType {
  EXACT_MATCH
  ADJACENT
  SUBSTITUTE
  UNKNOWN
}

/// How a piece of evidence relates to a claim, so conflicting evidence is not
/// collapsed.
enum ClaimEvidenceStance {
  SUPPORTS
  REFUTES
  CONTEXT
}
