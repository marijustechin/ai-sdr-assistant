// Prisma schema — single schema and migration chain.
//
// Owned by @ai-sdr/database (packages/database). No other package or module may
// define a schema or run migrations. Every model carries a `/// @owner <module>`
// tag so ownership is machine-readable (see docs/data-ownership.md §5).
//
// Prisma cannot express every constraint; CHECK constraints added in the
// initial migration SQL are documented in docs/data-model.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Canonical product identity (stored once, reusable across offers).
/// @owner products-and-offers
model Product {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String                 @db.VarChar(255)
  scientificName String?                @map("scientific_name") @db.VarChar(255)
  description    String?                @db.Text
  category       String?                @db.VarChar(120)
  lifecycleStatus ProductLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  offers Offer[]
  facts  ProductFact[]

  @@map("products")
}

/// A concrete sellable product form (variant) of exactly one Product.
/// Example: "Thermo Abachi STS 3D" is an Offer of "Abachi".
/// @owner products-and-offers
model Offer {
  id               String      @id @default(uuid()) @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  name             String      @db.VarChar(255)
  commercialStatus OfferStatus @default(DRAFT) @map("commercial_status")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  facts          ProductFact[]
  opportunities  Opportunity[]

  @@index([productId])
  @@map("offers")
}

/// One structured fact about exactly one Product or one Offer (never both,
/// never neither — enforced by a CHECK constraint in the migration).
/// @owner products-and-offers
model ProductFact {
  id           String         @id @default(uuid()) @db.Uuid
  productId    String?        @map("product_id") @db.Uuid
  offerId      String?        @map("offer_id") @db.Uuid
  key          String         @db.VarChar(255)
  valueText    String?        @map("value_text") @db.Text
  valueNumeric Decimal?       @map("value_numeric") @db.Decimal(18, 6)
  unit         String?        @db.VarChar(64)
  status       FactStatus     @default(PENDING)
  visibility   FactVisibility @default(OPERATIONAL)
  sourceLabel  String?        @map("source_label") @db.VarChar(255)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  offer   Offer?   @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([offerId])
  @@index([key])
  @@map("product_facts")
}

/// A country/region + market segment combination (duplicates prevented).
/// `country` holds a country OR region identifier (documented simplification).
/// @owner opportunities
model TargetMarket {
  id             String             @id @default(uuid()) @db.Uuid
  country        String             @db.VarChar(120)
  segment        String             @db.VarChar(255)
  lifecycleStatus TargetMarketStatus @default(ACTIVE) @map("lifecycle_status")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  opportunities    OpportunityTargetMarket[]
  researchRunScopes ResearchRunTargetMarket[]

  @@unique([country, segment])
  @@map("target_markets")
}

/// The commercial work unit; belongs to exactly one Offer.
/// @owner opportunities
model Opportunity {
  id             String             @id @default(uuid()) @db.Uuid
  offerId        String             @map("offer_id") @db.Uuid
  name           String             @db.VarChar(255)
  objective      String?            @db.Text
  lifecycleStatus OpportunityStatus @default(DRAFT) @map("lifecycle_status")
  contextVersion Int                @default(1) @map("context_version")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  offer         Offer                        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  targetMarkets OpportunityTargetMarket[]
  researchRuns  ResearchRun[]

  @@index([offerId])
  @@map("opportunities")
}

/// Explicit join between an Opportunity and its TargetMarkets.
/// @owner opportunities
model OpportunityTargetMarket {
  id            String       @id @default(uuid()) @db.Uuid
  opportunityId String       @map("opportunity_id") @db.Uuid
  targetMarketId String      @map("target_market_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  opportunity  Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  targetMarket TargetMarket  @relation(fields: [targetMarketId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, targetMarketId])
  @@index([targetMarketId])
  @@map("opportunity_target_markets")
}

/// An auditable record that market research was requested/executed for one
/// Opportunity. Holds no LLM chain-of-thought, credentials, or scraped pages.
/// @owner market-researcher
model ResearchRun {
  id             String            @id @default(uuid()) @db.Uuid
  opportunityId  String            @map("opportunity_id") @db.Uuid
  status         ResearchRunStatus @default(QUEUED)
  contextVersion Int               @map("context_version")
  requestedAt    DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt      DateTime?         @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?         @map("finished_at") @db.Timestamptz(6)
  errorCode      String?           @map("error_code") @db.VarChar(120)
  errorNote      String?           @map("error_note") @db.Text
  pauseReason    ResearchRunPauseReason? @map("pause_reason")
  pauseNote      String?           @map("pause_note") @db.Text
  checkpoint     Json?             @map("checkpoint")
  checkpointAt   DateTime?         @map("checkpoint_at") @db.Timestamptz(6)
  /// Validated operator request parameters (goals, geography, segment policy,
  /// questions, constraints, execution limits). Null for runs not created from
  /// the product-independent request flow.
  requestParameters Json?         @map("request_parameters")
  /// Optional client idempotency key so a double-click/retry cannot create a
  /// duplicate research request.
  requestKey     String?           @unique @map("request_key") @db.VarChar(120)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  opportunity   Opportunity               @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  targetMarkets ResearchRunTargetMarket[]
  queries       ResearchQuery[]
  evidence      Evidence[]
  claims        Claim[]
  offerings     ResearchOffering[]

  @@index([opportunityId])
  @@map("research_runs")
}

/// Target-market scope of a ResearchRun (explicit join + compound uniqueness).
/// @owner market-researcher
model ResearchRunTargetMarket {
  id             String       @id @default(uuid()) @db.Uuid
  researchRunId  String       @map("research_run_id") @db.Uuid
  targetMarketId String       @map("target_market_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  researchRun  ResearchRun  @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  targetMarket TargetMarket @relation(fields: [targetMarketId], references: [id], onDelete: Restrict)

  @@unique([researchRunId, targetMarketId])
  @@index([targetMarketId])
  @@map("research_run_target_markets")
}

/// A single discovery/search query issued during a ResearchRun: what was asked,
/// with which tool/provider, when it ran, and its outcome. Operational
/// provenance only — never model reasoning or chain-of-thought.
/// @owner market-researcher
model ResearchQuery {
  id            String              @id @default(uuid()) @db.Uuid
  researchRunId String              @map("research_run_id") @db.Uuid
  queryText     String              @map("query_text") @db.Text
  provider      String?             @db.VarChar(120)
  status        ResearchQueryStatus @default(PENDING)
  executedAt    DateTime?           @map("executed_at") @db.Timestamptz(6)
  resultCount   Int?                @map("result_count")
  errorCode     String?             @map("error_code") @db.VarChar(120)
  errorNote     String?             @map("error_note") @db.Text
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  researchRun ResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade)

  @@index([researchRunId])
  @@map("research_queries")
}

/// A concrete discovered source (usually a fetched URL), deduplicated by URL so
/// the same source is not stored repeatedly. This is the raw reference; the
/// factual observation extracted from it lives in `evidence`.
/// @owner evidence
model SourceReference {
  id         String   @id @default(uuid()) @db.Uuid
  url        String   @db.VarChar(2048)
  title      String?  @db.VarChar(512)
  publisher  String?  @db.VarChar(255)
  sourceType String?  @map("source_type") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence Evidence[]
  offerings ResearchOffering[]

  @@unique([url])
  @@map("source_references")
}

/// A factual observation extracted from a source during a run — the raw
/// evidence. Deliberately separate from `claims` (the conclusions drawn from
/// it), so evidence and inference cannot be collapsed.
/// @owner evidence
model Evidence {
  id                 String                     @id @default(uuid()) @db.Uuid
  sourceReferenceId  String                     @map("source_reference_id") @db.Uuid
  researchRunId      String                     @map("research_run_id") @db.Uuid
  evidenceText       String                     @map("evidence_text") @db.Text
  verificationStatus EvidenceVerificationStatus @default(UNVERIFIED) @map("verification_status")
  retrievedAt        DateTime?                  @map("retrieved_at") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceReference SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  researchRun     ResearchRun     @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  claimLinks      ClaimEvidence[]
  offerings       ResearchOffering[]

  @@index([sourceReferenceId])
  @@index([researchRunId])
  @@map("evidence")
}

/// A research conclusion/assertion derived from evidence. One claim may be
/// supported, contradicted, or contextualised by many evidence records.
///
/// A claim also has a small **correction lifecycle** (`lifecycleStatus`) that is
/// deliberately separate from `type` (FACT/INFERENCE/UNKNOWN) and from evidence
/// verification: a claim may be `CURRENT`, `RETRACTED`, or `REPLACED`. Retracted/
/// replaced claims are preserved (never edited or deleted); the correction
/// records its reason and timestamp, and a replacement points at another claim.
/// @owner evidence
model Claim {
  id               String              @id @default(uuid()) @db.Uuid
  researchRunId    String              @map("research_run_id") @db.Uuid
  type             ClaimType
  statement        String              @db.Text
  confidence       ClaimConfidence     @default(LOW)
  lifecycleStatus  ClaimLifecycleStatus @default(CURRENT) @map("lifecycle_status")
  correctionReason String?             @map("correction_reason") @db.Text
  correctedAt      DateTime?           @map("corrected_at") @db.Timestamptz(6)
  replacedByClaimId String?            @map("replaced_by_claim_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  researchRun   ResearchRun     @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  evidenceLinks ClaimEvidence[]
  replacedBy    Claim?          @relation("ClaimReplacement", fields: [replacedByClaimId], references: [id], onDelete: SetNull)
  replaces      Claim[]         @relation("ClaimReplacement")
  offerings     ResearchOffering[]

  @@index([researchRunId])
  @@index([lifecycleStatus])
  @@map("claims")
}

/// Claim↔evidence link. `stance` keeps conflicting evidence explicit instead of
/// silently averaging it into one conclusion.
/// @owner evidence
model ClaimEvidence {
  id         String              @id @default(uuid()) @db.Uuid
  claimId    String              @map("claim_id") @db.Uuid
  evidenceId String              @map("evidence_id") @db.Uuid
  stance     ClaimEvidenceStance @default(SUPPORTS)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  claim    Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([claimId, evidenceId])
  @@index([evidenceId])
  @@map("claim_evidence")
}

/// A structured, evidence-linked company offering observed during a run (e.g. a
/// supplier's thermo-Abachi cladding listing). Stores only values explicitly
/// recorded in the linked evidence/claim; an unrecorded field stays null and its
/// enum stays `UNKNOWN`. Populated through the API with mandatory provenance
/// (`sourceReferenceId` + `evidenceId`, optional `claimId`) and deduplicated by
/// a per-run `fingerprint`, so re-importing the same observation cannot create a
/// duplicate. Never authored from prose by the UI.
/// @owner evidence
model ResearchOffering {
  id                  String             @id @default(uuid()) @db.Uuid
  researchRunId       String             @map("research_run_id") @db.Uuid
  companyText         String?            @map("company_text") @db.VarChar(255)
  companyLocationText String?            @map("company_location_text") @db.VarChar(255)
  marketServedText    String?            @map("market_served_text") @db.VarChar(255)
  productText         String?            @map("product_text") @db.VarChar(512)
  applicationText     String?            @map("application_text") @db.VarChar(255)
  treatmentText       String?            @map("treatment_text") @db.VarChar(255)
  dimensionsText      String?            @map("dimensions_text") @db.VarChar(255)
  priceText           String?            @map("price_text") @db.Text
  /// Explicit numeric amount stated by the source, on the same basis as
  /// `priceText`; never parsed from prose. Null means not recorded numerically.
  priceAmountNumeric  Decimal?           @map("price_amount_numeric") @db.Decimal(18, 6)
  priceCurrency       String?            @map("price_currency") @db.VarChar(12)
  priceUnit           String?            @map("price_unit") @db.VarChar(64)
  vatStatus           OfferingVatStatus  @default(UNKNOWN) @map("vat_status")
  priceBasis          OfferingPriceBasis @default(UNKNOWN) @map("price_basis")
  sampleKind          OfferingSampleKind @default(UNKNOWN) @map("sample_kind")
  matchType           OfferingMatchType  @default(UNKNOWN) @map("match_type")
  sourceReferenceId   String             @map("source_reference_id") @db.Uuid
  evidenceId          String             @map("evidence_id") @db.Uuid
  claimId             String?            @map("claim_id") @db.Uuid
  fingerprint         String             @db.VarChar(64)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  researchRun     ResearchRun     @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  sourceReference SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  evidence        Evidence        @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  claim           Claim?          @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@unique([fingerprint])
  @@index([researchRunId])
  @@index([evidenceId])
  @@index([claimId])
  @@map("research_offerings")
}

enum ProductLifecycleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OpportunityStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum TargetMarketStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FactStatus {
  PENDING
  CONFIRMED
  SUPERSEDED
}

enum FactVisibility {
  OPERATIONAL
  RESTRICTED
}

enum ResearchRunStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

/// Why a `PAUSED` run stopped. Kept separate from the lifecycle status and from
/// `error*` (which belong to `FAILED`).
enum ResearchRunPauseReason {
  BUDGET_EXHAUSTED
  ACCESS_BLOCKED
  CONTEXT_CHANGED
  DIMINISHING_RETURNS
  NEEDS_HUMAN
}

enum ResearchQueryStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Whether an evidence item rests on a fetched, retrievable source (`VERIFIED`)
/// or is still a lead (`UNVERIFIED`). `UNKNOWN` conclusions are claim types.
enum EvidenceVerificationStatus {
  VERIFIED
  UNVERIFIED
}

/// Canonical claim types: a `FACT` is stated by fetched evidence, an
/// `INFERENCE` is derived from evidence, an `UNKNOWN` is not established.
enum ClaimType {
  FACT
  INFERENCE
  UNKNOWN
}

enum ClaimConfidence {
  HIGH
  MEDIUM
  LOW
}

/// Correction lifecycle of a claim, kept separate from `ClaimType` and from
/// `EvidenceVerificationStatus`. `REPLACED` claims carry a `replacedByClaimId`;
/// `RETRACTED` claims do not.
enum ClaimLifecycleStatus {
  CURRENT
  RETRACTED
  REPLACED
}

/// Recorded VAT treatment of an offering price. `UNKNOWN` means not recorded.
enum OfferingVatStatus {
  INCLUDED
  EXCLUDED
  NOT_STATED
  UNKNOWN
}

/// Recorded commercial basis of an offering price. Never inferred.
enum OfferingPriceBasis {
  RETAIL_LIST
  TRADE_B2B
  UNKNOWN
}

/// Whether a recorded price is for a sample or a full product. Never inferred.
enum OfferingSampleKind {
  SAMPLE
  FULL_PRODUCT
  UNKNOWN
}

/// How an offering relates to the researched product. Never inferred from prose
/// alone; the researcher records the classification explicitly.
enum OfferingMatchType {
  EXACT_MATCH
  ADJACENT
  SUBSTITUTE
  UNKNOWN
}

/// How a piece of evidence relates to a claim, so conflicting evidence is not
/// collapsed.
enum ClaimEvidenceStance {
  SUPPORTS
  REFUTES
  CONTEXT
}
