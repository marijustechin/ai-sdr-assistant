# AI SDR Assistant — local development environment (safe defaults).
#
# Copy to `.env` before running the DB or the API:
#   cp .env.example .env
#
# These are local-only development credentials. Never commit a real `.env`.

# --- Docker Compose (PostgreSQL) -------------------------------------------
POSTGRES_USER=ai_sdr
POSTGRES_PASSWORD=ai_sdr_dev
POSTGRES_DB=ai_sdr
POSTGRES_PORT=54329

# --- Prisma / API -----------------------------------------------------------
# The connection string used by the Prisma CLI and apps/api.
DATABASE_URL=postgresql://ai_sdr:ai_sdr_dev@localhost:54329/ai_sdr?schema=public

# --- Internal service-to-service API key ------------------------------------
# Required by every business endpoint via the `x-internal-api-key` header.
# Generate a random value of at least 16 characters for local development and
# never commit a real key. When unset, business endpoints fail closed (503);
# `GET /health` and `GET /ready` stay public.
INTERNAL_API_KEY=

# Optional: isolated database used by the database-package integration tests.
# Falls back to the same server with an `ai_sdr_test` database when unset.
# TEST_DATABASE_URL=postgresql://ai_sdr:ai_sdr_dev@localhost:54329/ai_sdr_test?schema=public
